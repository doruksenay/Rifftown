{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local --env-file-if-exists=../.env src/main.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../.env.local --env-file-if-exists=../.env src/worker-main.ts",
    "migrate": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=../.env src/migrate-main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "start:migrate": "node dist/migrate-main.js",
    "make-admin": "tsx src/make-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@rifftown/shared": "*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
