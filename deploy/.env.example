# Bu dosyayı .env adıyla kopyala ve değerleri doldur. (setup.sh bunu senin yerine yapar.)

# Sunucunun alan adı. DNS'te bu ad sunucunun IP adresini göstermeli (A kaydı).
DOMAIN=api.ornekoyun.com

# Veritabanı şifresi: uzun ve rastgele olsun.
DB_PASSWORD=degistir-beni

# Oyun hızı: 1 = gerçek zaman. Kapalı test sırasında 10 yazarsan her şey 10 kat hızlı akar.
GAME_SPEED=1

# İsteğe bağlı: Expo hesabındaki "Access Token" (push bildirim güvenliği için önerilir)
EXPO_ACCESS_TOKEN=

# VIP satın alma bildirimleri: RevenueCat → Integrations → Webhooks bölümünde
# "Authorization header value" alanına yazdığın uzun, rastgele değerin aynısı.
REVENUECAT_WEBHOOK_SECRET=
